{
  "name": "workshop-backend",
  "version": "1.0.0",
  "description": "Backend API & Sync Server for Automotive Workshop Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/database/init.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:init:pg": "tsx src/database/init.postgres.ts",
    "db:seed:pg": "tsx src/database/seed.postgres.ts",
    "test": "tsx tests/run-all-tests.ts",
    "backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "uuid": "^9.0.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}

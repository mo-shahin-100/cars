# ========================================================
# Workshop Management System - Backend Environment Config
# ========================================================

# Server Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret for Authentication
JWT_SECRET=super_secret_workshop_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# --------------------------------------------------------
# 1. For Local PostgreSQL (localhost:5432):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workshop_db

# 2. For Free Cloud PostgreSQL (Supabase / Neon):
# DATABASE_URL=postgresql://username:password@ep-random-name.neon.tech/workshop_db?sslmode=require

# Fallback SQLite Database file (used if PostgreSQL is offline)
DB_FILE=./data/workshop.db
